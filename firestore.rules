rules_version = '2';
// Friesta: each store's data lives under stores/{ownerUid}/...
// Only the signed-in owner account of that store can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stores/{storeId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == storeId;
    }
  }
}
